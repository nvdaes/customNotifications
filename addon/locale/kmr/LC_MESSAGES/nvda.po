#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:27
msgid "&Truncate notifications"
msgstr "&Agahdariyan Bibire"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:33
msgid "Type the characters to be used as the &start limit of notifications"
msgstr "Tîpên ku wekî sînorê destpêkirina agahdariyan werin bikar anîn binivîsin"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:37
msgid "Type the characters to be used as the end &limit of notifications"
msgstr "Tîpên ku wekî dawiya &sînorê agahdariyan werin bikar anîn binivîse"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:41
msgid "Sele&ct output modes for notifications"
msgstr "Modên derketinê ji bo agahdariyan hilbijêre"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:44
msgid "Speech"
msgstr "Gotar"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:46
msgid "Braille"
msgstr ""

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:61
msgid "Type the text to show a test &notification"
msgstr "Nivîsê binivîse da ku ceribandinek nîşan bide"

#. Translators: label of a dialog.
#: addon\globalPlugins\customNotifications\gui.py:66
msgid "&Show test notification"
msgstr "Agahdariya &Testê nîşan bide"

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:64
#, python-format
msgid "Shows the %s settings."
msgstr "Mîhengên %s nîşan dide."

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:72
#, python-format
msgid "Toggles Truncate notifications option of %s."
msgstr "Vebijarka kurtkirina agahdariyan a %s vediguhezîne/diguhezîne."

#. Translators: message presented when truncate notifications are disabled.
#: addon\globalPlugins\customNotifications\__init__.py:80
msgid "Truncate notifications disabled"
msgstr "Agahiyên kurtkirî neçalak in"

#. Translators: message presented when truncate notifications are enabled.
#: addon\globalPlugins\customNotifications\__init__.py:84
msgid "Truncate notifications enabled"
msgstr "Agahiyên kurtkirî çalak in"

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:88
#, python-format
msgid "Toggles speech option of %s."
msgstr "Vebijarka axaftinê ya %s vediguherîne/diguhezîne."

#. Translators: message presented when customNotifications speech is disabled.
#: addon\globalPlugins\customNotifications\__init__.py:96
#, python-format
msgid "Speech disabled for %s"
msgstr "Axaftin ji bo %s hatiye astengkirin"

#. Translators: message presented when customNotifications speech is enabled.
#: addon\globalPlugins\customNotifications\__init__.py:100
#, python-format
msgid "Speech enabled for %s"
msgstr "Axaftin ji bo %s çalak e"

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:104
#, python-format
msgid "Toggles braille option of %s."
msgstr "Vebijarka braille ya %s vediguherîne/diguhezîne."

#. Translators: message presented when customNotifications braille is disabled.
#: addon\globalPlugins\customNotifications\__init__.py:112
#, python-format
msgid "Braille disabled for %s"
msgstr "Braille ji bo %s neçalak e"

#. Translators: message presented when customNotifications braille is enabled.
#: addon\globalPlugins\customNotifications\__init__.py:116
#, python-format
msgid "Braille enabled for %s"
msgstr "Braille ji bo %s çalak e"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Custom Notifications"
msgstr "Agahdariyên Taybet"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Choose how NVDA should read toast notifications.\n"
"You can read just the application which sent a toast, and choose if notifications are spoken, displayed in braille or both.\n"
"This may  improve your experience with toast notifications and help you to keep your privacy."
msgstr "Hilbijêre ka NVDA çawa agahdariyên toastê bixwîne.\n"
"Hûn dikarin tenê sepana ku toast şandiye bixwînin û hilbijêrin ka agahdarî werin gotin, bi braille werin nîşandan an jî herduyan.\n"
"Ev dibe ku ezmûna we bi agahdariyên toastê re baştir bike û ji we re bibe alîkar ku hûn nepeniya xwe biparêzin."

