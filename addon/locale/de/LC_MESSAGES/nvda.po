#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:64
#, python-format
msgid "Shows the %s settings."
msgstr "Zeigt die %s-Einstellungen an."

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:72
#, python-format
msgid "Toggles Truncate notifications option of %s."
msgstr "Schaltet die Option \"Benachrichtigungen abschneiden\" von %s um."

#. Translators: message presented when truncate notifications are disabled.
#: addon\globalPlugins\customNotifications\__init__.py:80
msgid "Truncate notifications disabled"
msgstr "Benachrichtigungen abschneiden ausgeschaltet"

#. Translators: message presented when truncate notifications are enabled.
#: addon\globalPlugins\customNotifications\__init__.py:84
msgid "Truncate notifications enabled"
msgstr "Benachrichtigungen abschneiden eingeschaltet"

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:88
#, python-format
msgid "Toggles speech option of %s."
msgstr "Schaltet die Option für die Sprachausgabe von %s um."

#. Translators: message presented when customNotifications speech is disabled.
#: addon\globalPlugins\customNotifications\__init__.py:96
#, python-format
msgid "Speech disabled for %s"
msgstr "Sprachausgabe für %s ausgeschaltet"

#. Translators: message presented when customNotifications speech is enabled.
#: addon\globalPlugins\customNotifications\__init__.py:100
#, python-format
msgid "Speech enabled for %s"
msgstr "Sprachausgabe für %s eingeschaltet"

#. Translators: message presented in input mode.
#: addon\globalPlugins\customNotifications\__init__.py:104
#, python-format
msgid "Toggles braille option of %s."
msgstr "Schaltet die Option für die Brailleausgabe von %s um."

#. Translators: message presented when customNotifications braille is disabled.
#: addon\globalPlugins\customNotifications\__init__.py:112
#, python-format
msgid "Braille disabled for %s"
msgstr "Brailleausgabe für %s ausgeschaltet"

#. Translators: message presented when customNotifications braille is enabled.
#: addon\globalPlugins\customNotifications\__init__.py:116
#, python-format
msgid "Braille enabled for %s"
msgstr "Brailleausgabe für %s eingeschaltet"

#. Add-on summary/title, usually the user visible name of the add-on
#. Translators: Summary/title for this add-on
#. to be shown on installation and add-on information found in add-on store
#: buildVars.py:20
msgid "Custom Notifications"
msgstr "Benutzerdefinierte Benachrichtigungen"

#. Add-on description
#. Translators: Long description to be shown for this add-on on add-on information from add-on store
#: buildVars.py:23
msgid "Choose how NVDA should read toast notifications.\n"
"You can read just the application which sent a toast, and choose if notifications are spoken, displayed in braille or both.\n"
"This may  improve your experience with toast notifications and help you to keep your privacy."
msgstr "Wählen Sie aus, wie NVDA die Toast-Benachrichtigungen anzeigen soll.\n"
"Sie können nur die Anwendung hören, die eine Toast-Benachrichtigung gesendet hat und wählen Sie aus, ob die Benachrichtigungen über die Sprachausgabe oder auf der Braillezeile ausgegeben oder beides angezeigt werden soll.\n"
"Dies kann die Erfahrung mit Toast-Benachrichtigungen verbessern und helfen, die Privatsphäre zu wahren."

